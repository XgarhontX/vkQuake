#version 450
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable
#extension GL_GOOGLE_include_directive : enable

// https://learnopengl.com/Guest-Articles/2022/Phys.-Based-Bloom

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (push_constant) uniform PushConsts
{
	vec2  src_size;
	vec2  inv_src_size;
	float intensity;
	float threshold;
	float p0;
	float p1;
}
push_constants;

layout (set = 0, binding = 0) uniform sampler2D src_texture;
layout (set = 1, binding = 0, rgba16f) uniform image2D dst_image;
layout (set = 2, binding = 0) uniform sampler2D scene_texture;

const float GAMMA = 2.2;
const float EXPOSURE = 4.0; // must match the exposure makeup in postprocess.frag

// Luma Color.hlsl
void main ()
{
	const ivec2 dst_size = imageSize (dst_image);
	const ivec2 id = ivec2 (gl_GlobalInvocationID.xy);
	if (id.x >= dst_size.x || id.y >= dst_size.y)
		return;

	// transform the coordinate from [0,extent] to [-0.5, extent-0.5]
	vec2 texcoord = (vec2(id) + 0.5) / vec2(dst_size);
	vec2 coord_grid = texcoord * push_constants.src_size - 0.5;
	vec2 index = floor(coord_grid);
	vec2 fraction = coord_grid - index;
	vec2 one_frac = 1.0 - fraction;
	vec2 one_frac2 = one_frac * one_frac;
	vec2 fraction2 = fraction * fraction;
	vec2 w0 = 1.0 / 6.0 * one_frac2 * one_frac;
	vec2 w1 = 2.0 / 3.0 - 0.5 * fraction2 * (2.0 - fraction);
	vec2 w2 = 2.0 / 3.0 - 0.5 * one_frac2 * (2.0 - one_frac);
	vec2 w3 = 1.0 / 6.0 * fraction2 * fraction;
	vec2 g0 = w0 + w1;
	vec2 g1 = w2 + w3;

	// h0 = w1/g0 - 1, move from [-0.5, extent-0.5] to [0, extent]
	vec2 h0 = (w1 / g0) - 0.5 + index;
	vec2 h1 = (w3 / g1) + 1.5 + index;

	// fetch the four linear interpolations
	vec3 tex00 = textureLod (src_texture, vec2 (h0.x, h0.y) * push_constants.inv_src_size, 0.0).rgb;
	vec3 tex10 = textureLod (src_texture, vec2 (h1.x, h0.y) * push_constants.inv_src_size, 0.0).rgb;
	vec3 tex01 = textureLod (src_texture, vec2 (h0.x, h1.y) * push_constants.inv_src_size, 0.0).rgb;
	vec3 tex11 = textureLod (src_texture, vec2 (h1.x, h1.y) * push_constants.inv_src_size, 0.0).rgb;

	// weigh along the y-direction
	tex00 = mix(tex01, tex00, vec3(g0.y));
	tex10 = mix(tex11, tex10, vec3(g0.y));

	// weigh along the x-direction
	vec3 up = mix (tex10, tex00, vec3( g0.x));

	vec3 bloom = imageLoad (dst_image, id).rgb + up; // accumulate
	imageStore (dst_image, id, vec4 (bloom, 0.0));
}
